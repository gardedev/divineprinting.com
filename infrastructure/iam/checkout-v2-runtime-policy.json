{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckoutCartTransaction",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:UpdateItem", "dynamodb:ConditionCheckItem"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-carts",
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-cart-items",
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-cart-items/index/ProductCartItemIndex"
      ]
    },
    {
      "Sid": "CheckoutOrderTransaction",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-orders-v2",
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-orders-v2/index/*",
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-order-items-v2",
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-order-items-v2/index/*"
      ]
    },
    {
      "Sid": "AuthoritativeProductReads",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-products",
        "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-products/index/*"
      ]
    },
    {
      "Sid": "AuthoritativeCustomerReads",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:911762440868:table/divine-printing-customers-v2"
    },
    {
      "Sid": "RuntimeLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:911762440868:log-group:/aws/lambda/divine-printing-checkout:*"
    }
  ]
}
